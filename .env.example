# The sbb-twin deployment (its API is under /api). Required.
TWIN_ORIGIN=https://twin.example.org
# The ktor_app backend (API under /api/v1), used only to resolve public train numbers. Optional.
KTOR_ORIGIN=https://backend.example.org
# Where this server is reachable from outside (for citation URLs). Optional locally.
PUBLIC_ORIGIN=https://mcp.example.org
# HTTP mode
PORT=3333
HOST=127.0.0.1
# 1 behind a reverse proxy (Coolify) so rate limits use X-Forwarded-For
TRUST_PROXY=0
# Extra browser origins allowed on /mcp, comma separated
ALLOWED_ORIGINS=
